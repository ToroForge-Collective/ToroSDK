{
  "compilerOptions": {
       "target": "es2017",                                  
    /* Modules */
    "module": "commonjs",                               
    "rootDir": "./src",                                  
    "outDir": "./dist",                                   

    "esModuleInterop": true,                            
    "forceConsistentCasingInFileNames": true,            
    /* Type Checking */
    "strict": true,                                     


    "skipLibCheck": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "declaration": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["es2017", "dom"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
