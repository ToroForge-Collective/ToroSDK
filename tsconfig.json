{
  "compilerOptions": {
    "target": "es2020",
    /* Modules */
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    /* Type Checking */
    "strict": true,

    "skipLibCheck": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "declaration": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["es2020", "dom"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
